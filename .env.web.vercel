# Web app (.env) for Vercel project with Root Directory: apps/web
# Shared values are in .env.shared.vercel

# Auth gateway on web domain
NEXT_PUBLIC_AUTH_ORIGIN=https://fiap-tech-challenge-web.vercel.app
NEXT_PUBLIC_AUTH_PATH_PREFIX=/auth
NEXT_PUBLIC_APP_ORIGIN=https://fiap-tech-challenge-web.vercel.app

# Backend auth deployment (used by server-side fetch/rewrites)
AUTH_ORIGIN=https://fiap-tech-challenge-auth.vercel.app

# Investments microfrontend
INVESTMENTS_ORIGIN=https://fiap-tech-challenge-investments.vercel.app

# Angular financial alerts microfrontend
NEXT_PUBLIC_FINANCIAL_ALERTS_ORIGIN=https://fiap-tech-challenge-financial-alerts-angular.vercel.app
