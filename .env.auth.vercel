# Auth app (.env) for Vercel project with Root Directory: apps/auth
# Ready-to-upload values for this monorepo.
# Shared values are in .env.shared.vercel

# Required
NEXT_PUBLIC_AUTH_ORIGIN=https://fiap-tech-challenge-auth.vercel.app
NEXT_PUBLIC_APP_ORIGIN=https://fiap-tech-challenge-web.vercel.app
AUTH_ASSET_PREFIX=/auth
AUTH_ALLOWED_ORIGINS=https://fiap-tech-challenge-web.vercel.app,https://fiap-tech-challenge-investments.vercel.app,https://fiap-tech-challenge-auth.vercel.app

# Mock user (single user approach)
AUTH_MOCK_USER_EMAIL=mariaj.lemos@yahoo.com
AUTH_MOCK_USER_NAME=maria
AUTH_MOCK_USER_PASSWORD_HASH=$2b$10$fgkX8w.DmPBxzGrCkI/ai.vUWS/QfGhH4IyvSU5h8Vv4506WdsTwi

# Alternative to single user: JSON list of users (leave empty if using fields above)
AUTH_MOCK_USERS_JSON=[{"id":"1","email":"mariaj.lemos@yahoo.com","name":"maria","passwordHash":"$2b$10$fgkX8w.DmPBxzGrCkI/ai.vUWS/QfGhH4IyvSU5h8Vv4506WdsTwi"}]

# Recommended
AUTH_COOKIE_DOMAIN=
