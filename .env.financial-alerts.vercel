# Financial alerts Angular app for the Vercel project with
# Root Directory: apps/financial-alerts-angular
# Project: fiap-tech-challenge-financial-alerts-angular

# No runtime environment variables are required by this static deployment.
# The web host passes locale, authentication origin, authentication path and
# return URL to the Angular parcel through single-spa properties.

# Do not upload .env.shared.vercel to this project. The Angular bundle is
# public and does not need AUTH_SECRET or NEXTAUTH_SECRET.
